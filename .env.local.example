DATABASE_URL=postgresql://user:password@localhost:5432/xxxxxxxx

RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=bonjour@tonemail.fr

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# 4 prix Stripe : Club 9,90 €/mois, Club 99 €/an, Pro 19,90 €/mois, Pro 199 €/an
STRIPE_PRICE_CLUB_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_CLUB_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxx
# En dev : `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=xxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx


ADMIN_PASSWORD=xxxxx
ADMIN_SECRET=xxxxx

SUPABASE_SERVICE_ROLE_KEY=xxxxxx

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rendu navigateur pour Ten'Up (traverse le sas Queue-it). Optionnel :
# sans clé, la récupération auto Ten'Up est désactivée (saisie manuelle).
SCRAPINGBEE_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Publication réseaux sociaux (Meta : Facebook Pages + Instagram).
# App Meta Developer (developers.facebook.com) — produit "Facebook Login".
META_APP_ID=xxxxxxxxxxxxxxxx
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot Telegram (validation des posts en mode Auto + validation, digest quotidien).
# Token du bot BotFather ; secret vérifié sur le header
# x-telegram-bot-api-secret-token du webhook (voir setWebhook).
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
# @username du bot (sans le @), utilisé pour construire le lien t.me/<bot>?start=<code>
TELEGRAM_BOT_USERNAME=xxxxxxxxxx

# Routes /api/cron/* (scrape Ten'Up, digest Telegram, nettoyage) — header
# Authorization: Bearer <CRON_SECRET> attendu par Vercel Cron.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxx
