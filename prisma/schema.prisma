generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  TENNIS
  PADEL
  FOOTBALL
  HANDBALL
  BASKETBALL
  VOLLEYBALL
  OTHER
}

enum MatchType {
  INTERCLUB
  TOURNAMENT
}

enum HomeAway {
  DOMICILE
  EXTERIEUR
}

model Organization {
  id               String               @id @default(cuid())
  name             String
  plan             String               @default("FREE") // FREE | PRO | STRUCTURE
  stripeCustomerId String?
  stripeSubId      String?
  suspended        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  members          OrganizationMember[]
  clubs            Club[]
}

model OrganizationMember {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  role      String       @default("MEMBER") // OWNER | MEMBER
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
}

model Club {
  id                  String               @id @default(cuid())
  userId              String               @unique
  orgId               String?
  org                 Organization?        @relation(fields: [orgId], references: [id])
  name                String
  sport               String
  primaryColor        String               @default("#1a1a2e")
  secondaryColor      String               @default("#e94560")
  logoUrl             String?
  visualConfig        Json?
  tennisVisualConfig  Json?
  postVisualConfigs   Json? // { [PostVisualKind]: VisualConfig } — visuels des 7 types hors Résultat/Tennis
  tenupUrl            String?
  suspended           Boolean              @default(false)
  automationMode      String               @default("MANUAL") // MANUAL | AUTO_REVIEW | FULL_AUTO
  telegramChatId      String?              @unique
  telegramLinkCode    String?              @unique
  contentTone         String               @default("STANDARD") // STANDARD | FUN | SOBER
  customInstructions  String?              @db.Text // consignes libres injectées dans tous les prompts IA
  signaturePhrase     String? // phrase de signature optionnelle ajoutée en fin de post
  bannedWords         String?              @db.Text // mots/expressions à éviter dans les légendes générées
  createdAt           DateTime             @default(now())
  matches             MatchResult[]
  tournamentSchedules TournamentSchedule[]
  weeklySchedules     WeeklySchedule[]
  tenupSchedules      TenupSchedule[]
  usageEvents         UsageEvent[]
  socialConnections   SocialConnection[]
  seasonRecaps        SeasonRecap[]
  matchAnnouncements  MatchAnnouncement[]
  playerSpotlights    PlayerSpotlight[]
  clubAnnouncements   ClubAnnouncement[]
  engagementPolls     EngagementPoll[]
  customPosts         CustomPost[]
}

model SocialConnection {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  provider          String // 'facebook' | 'instagram'
  providerAccountId String // page id (facebook) ou ig user id (instagram)
  accountName       String // nom de la Page / @username IG
  avatarUrl         String?
  accessToken       String    @db.Text // page access token (long-lived)
  igUserId          String? // compte IG business lié (sur une connexion facebook)
  tokenExpiresAt    DateTime?
  meta              Json?
  createdAt         DateTime  @default(now())

  @@unique([clubId, provider, providerAccountId])
  @@index([clubId])
}

model TenupSchedule {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  weekStart DateTime
  matches   Json
  clubName  String?
  scrapedAt DateTime @default(now())

  @@unique([clubId, weekStart])
}

model UsageEvent {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  kind      String // 'ai_generation' | 'tenup_scrape' | 'intent_extraction'
  model     String?
  tokensIn  Int?
  tokensOut Int?
  credits   Int?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([kind, createdAt])
}

model MatchResult {
  id          String      @id @default(cuid())
  clubId      String
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  date        DateTime
  opponent    String
  homeScore   Int
  awayScore   Int
  isHome      Boolean     @default(true)
  competition String?
  notes       String?
  extraData   Json?
  // Tennis / Padel interclub fields
  sport       String?
  matchType   MatchType?
  teamName    String?
  homeAway    HomeAway?
  scoreDetail Json?
  globalScore String?
  division    String?
  round       String?
  createdAt   DateTime    @default(now())
  posts       GeneratedPost[]
}

model TournamentSchedule {
  id             String          @id @default(cuid())
  clubId         String
  club           Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sport          Sport
  pdfUrl         String?
  rawText        String          @db.Text
  matchDate      DateTime
  tournamentName String
  venue          String          @default("")
  parsedData     Json
  createdAt      DateTime        @default(now())
  posts          GeneratedPost[]
}

model WeeklySchedule {
  id        String          @id @default(cuid())
  clubId    String
  club      Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sport     Sport
  weekStart DateTime
  weekEnd   DateTime
  matches   Json
  createdAt DateTime        @default(now())
  posts     GeneratedPost[]
}

model SeasonRecap {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  wins        Int
  draws       Int
  losses      Int
  rankingNote String?
  createdAt   DateTime        @default(now())
  posts       GeneratedPost[]
}

model MatchAnnouncement {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  opponent    String
  matchDate   DateTime
  time        String?
  venue       String?
  competition String?
  isHome      Boolean         @default(true)
  note        String?
  createdAt   DateTime        @default(now())
  posts       GeneratedPost[]
}

model PlayerSpotlight {
  id           String          @id @default(cuid())
  clubId       String
  club         Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerName   String
  achievement  String
  periodLabel  String?
  createdAt    DateTime        @default(now())
  posts        GeneratedPost[]
}

model ClubAnnouncement {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category    String // RECRUITMENT | SPONSOR | CLUB_LIFE
  title       String
  description String          @db.Text
  ctaText     String?
  createdAt   DateTime        @default(now())
  posts       GeneratedPost[]
}

model EngagementPoll {
  id        String          @id @default(cuid())
  clubId    String
  club      Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  question  String
  options   Json // string[], 2 à 4 options
  createdAt DateTime        @default(now())
  posts     GeneratedPost[]
}

// Publication libre (assistant conversationnel dashboard, mode CUSTOM) —
// réservée aux demandes qui ne correspondent à aucun type structuré existant
// ni à une catégorie de ClubAnnouncement. Suit le même pattern qu'un type
// structuré (1 table par type + entrée dans lib/postTypes.ts) pour préserver
// l'isolation multi-club (clubOwnershipOr) sans dupliquer de logique.
model CustomPost {
  id                String          @id @default(cuid())
  clubId            String
  club              Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  objective         String // ce que le club cherche à obtenir (ex: "recruter des bénévoles")
  subject           String // sujet concret de la publication (ex: "buvette du tournoi")
  keyInformation    Json // string[] — informations factuelles explicitement fournies, jamais inventées
  callToAction      String?
  targetAudience    String?
  tone              String?
  desiredPlatforms  Json // string[] parmi 'instagram' | 'facebook' | 'whatsapp'
  suggestedCategory String? // pour la boucle d'évolution produit (analytics), jamais le texte brut
  createdAt         DateTime        @default(now())
  posts             GeneratedPost[]
}

model GeneratedPost {
  id                   String              @id @default(cuid())
  matchId              String?
  match                MatchResult?        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournamentScheduleId String?
  tournamentSchedule   TournamentSchedule? @relation(fields: [tournamentScheduleId], references: [id], onDelete: Cascade)
  weeklyScheduleId     String?
  weeklySchedule       WeeklySchedule?     @relation(fields: [weeklyScheduleId], references: [id], onDelete: Cascade)
  seasonRecapId        String?
  seasonRecap          SeasonRecap?        @relation(fields: [seasonRecapId], references: [id], onDelete: Cascade)
  matchAnnouncementId  String?
  matchAnnouncement    MatchAnnouncement?  @relation(fields: [matchAnnouncementId], references: [id], onDelete: Cascade)
  playerSpotlightId    String?
  playerSpotlight      PlayerSpotlight?    @relation(fields: [playerSpotlightId], references: [id], onDelete: Cascade)
  clubAnnouncementId   String?
  clubAnnouncement     ClubAnnouncement?   @relation(fields: [clubAnnouncementId], references: [id], onDelete: Cascade)
  engagementPollId     String?
  engagementPoll       EngagementPoll?     @relation(fields: [engagementPollId], references: [id], onDelete: Cascade)
  customPostId         String?
  customPost           CustomPost?         @relation(fields: [customPostId], references: [id], onDelete: Cascade)
  platform             String
  content              String              @db.Text
  postType             String              @default("MATCH_RESULT")
  // DRAFT | PENDING_REVIEW | PUBLISHING | PUBLISHED | PARTIAL | FAILED | REJECTED
  // PUBLISHING est transitoire : réservé atomiquement le temps de l'appel aux
  // API réseaux sociaux pour empêcher une double publication (cf. publishGeneratedPost).
  status               String              @default("DRAFT")
  imageUrl             String?
  publishedAt          DateTime?
  rejectedReason       String?
  createdAt            DateTime            @default(now())
  telegramMessages     TelegramMessage[]

  @@index([status])
  @@index([createdAt])
}

model TelegramMessage {
  id              String        @id @default(cuid())
  generatedPostId String
  generatedPost   GeneratedPost @relation(fields: [generatedPostId], references: [id], onDelete: Cascade)
  chatId          String
  messageId       String
  kind            String // 'preview' | 'digest'
  createdAt       DateTime      @default(now())

  @@index([generatedPostId])
}

/// Trace des actions administratives sensibles (suspension, suppression,
/// changement de plan...) depuis le dashboard admin. adminId/adminEmail
/// viennent du compte Supabase (app_metadata.role='admin'), pas d'une table
/// locale d'administrateurs. Pas de relation FK vers la ressource : le log
/// doit survivre à sa suppression. Jamais modifiable/supprimable depuis
/// l'interface standard.
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  adminEmail   String?
  action       String // ex: "club.suspend" | "organization.plan_change" | "user.delete"
  resourceType String // "club" | "organization" | "user"
  resourceId   String?
  beforeValue  Json?
  afterValue   Json?
  result       String   @default("success") // "success" | "failure"
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
